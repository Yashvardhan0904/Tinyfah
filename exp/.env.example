OLLAMA_BASE_URL=http://localhost:11434

LLM_PROVIDER=ollama
LLM_MODEL=qwen2.5:14b
LLM_FALLBACKS=groq/llama-3.3-70b-versatile
LLM_API_KEY=
LLM_BASE_URL=
LLM_TEMPERATURE=0
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=1
LLM_MAX_TOKENS=0
LLM_STRUCTURED_METHOD=auto

GROQ_API_KEY=
GROQ_BASE_URL=
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENROUTER_API_KEY=
TOGETHER_API_KEY=
DEEPSEEK_API_KEY=
MISTRAL_API_KEY=
XAI_API_KEY=
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_BASE_URL=

TINYFISH_URL=https://api.browser.tinyfish.ai
TINYFISH_API_KEY=

EXPLOIT_ALLOWED_HOSTS=staging.example.com
EXPLOIT_OWNER_TOKEN=
EXPLOIT_DRY_RUN=true
# SQL injection login runs submit credentials, so state changes must be enabled.
# Only enable this for an allowlisted target where EXPLOIT_OWNER_TOKEN is verified.
EXPLOIT_ENABLE_STATE_CHANGE=false
EXPLOIT_LOCAL_BROWSER_FALLBACK=true
EXPLOIT_LLM_ANALYSIS=false
EXPLOIT_MAX_ACTIONS=40
EXPLOIT_OWNERSHIP_TIMEOUT_SECONDS=15

MAX_REQUESTS_PER_RUN=200
MAX_RPS=2
MAX_CONCURRENT_SESSIONS=2
REQUEST_TIMEOUT_SECONDS=30
MAX_RESPONSE_BYTES=65536

CANARY_PATH=/canary.txt
CANARY_MARKER=TINYFAH-CANARY

TEST_USER_EMAIL=
TEST_USER_PASSWORD=
TEST_ADMIN_EMAIL=
TEST_ADMIN_PASSWORD=
